# Szablon pliku .env dla hostingu. Skopiuj go do katalogu z repozytorium
# na serwerze jako `.env` i uzupełnij wartości oznaczone ZMIEŃ.
#
# UWAGA: prawdziwy .env nigdy nie trafia do repozytorium.

APP_NAME="PM Property Manager"
APP_ENV=production
APP_KEY=ZMIEŃ_klucz_z_pliku_przygotowanego_lokalnie
APP_DEBUG=false
APP_URL=https://ascomm.pl/pm

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ZMIEŃ_nazwa_bazy
DB_USERNAME=ZMIEŃ_użytkownik_bazy
DB_PASSWORD=ZMIEŃ_hasło_bazy

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Poczta ustawiana jest w aplikacji (Administracja → Ustawienia poczty).
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="admin@energieableseportal.de"
MAIL_FROM_NAME="${APP_NAME}"

PM_VAT_RATE=0.23
PM_SETTLEMENT_PREFIX=ROZ
PM_DEFAULT_MARGIN=5

# Bramka SMS (SMSAPI.pl) — przypomnienia o płatnościach.
# SMSAPI_TEST=true: bramka sprawdza wiadomość, ale jej nie wysyła i nie pobiera opłaty.
# SMSAPI_SENDER: nazwa zatwierdzona w panelu SMSAPI, najwyżej 11 znaków (np. ASCOMM);
# puste = nadawca domyślny bramki.
#
# UWAGA: wartość ze spacją musi być w cudzysłowie, np. APP_NAME="PM Property Manager".
# Spacja bez cudzysłowu w dowolnej linii kończy się pustą stroną błędu 500 w całej aplikacji.
SMSAPI_TOKEN=
SMSAPI_SENDER=
SMSAPI_TEST=false
